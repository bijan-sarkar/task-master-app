# Application Environment
ENVIRONMENT=production
PORT=8000
APP_SECRET_KEY=replace-with-a-secure-random-string

# Supabase Database (PostgreSQL Connection String from Supabase Settings -> Database)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Email Settings (SMTP or Resend API)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM="Task Master AI <your_email@gmail.com>"

# Google Calendar Integration (OAuth 2.0 Credentials or Service Account JSON path)
GOOGLE_APPLICATION_CREDENTIALS_JSON=""

# WhatsApp Cloud API (Optional / Meta for Developers)
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="my_webhook_secret_verify_token"

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
